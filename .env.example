# Node >= 22.17 with node:sqlite.
# Normal entry: npm start  (same as: node start-live.mjs)
# With this file: node --env-file=.env start-live.mjs
# A key is optional at startup; you can also save it on the Model connection page.
WORLD_MONITOR=off
WORLD_COURSE=on
PORT=4174

# WORLD_MODEL=openai
# WORLD_MODEL_NAME=deepseek-flash
# WORLD_BASE_URL=https://api.deepseek.com
# WORLD_CHAT_COMPLETIONS_URL=https://api.deepseek.com/chat/completions
# An explicit full completion URL takes priority over WORLD_BASE_URL.
# Campus/custom credentials are not reused for official search tools.
# WORLD_SEARCH_API_KEY=your-separate-official-deepseek-key
# WORLD_MODEL_THINKING=enabled
# WORLD_MODEL_REASONING_EFFORT=high
# WORLD_MODEL_MAX_OUTPUT_TOKENS=32768
# WORLD_MODEL_TIMEOUT_MS=180000
# WORLD_SEARCH_PROVIDER=deepseek
# WORLD_API_KEY=replace-with-your-own-key
# WORLD_COURSE_POLL_MS=3600000

# Thinking uses additional time/tokens; a longer timeout alone does not enable it.
# For a faster comparison: deepseek-flash with WORLD_MODEL_THINKING=disabled
# and omit WORLD_MODEL_REASONING_EFFORT. Actual budgets are enforced per run.

# Never put a credential in web/ or commit .env. The repository ignores .env.

# Optional, disabled by default. Needs public Bing RSS access on the deployment network.
# WORLD_BING_SEARCH=enabled
# Search language/market is selected per query. No local Edge/browser installation is required.
